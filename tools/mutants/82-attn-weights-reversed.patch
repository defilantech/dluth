# Bug: values are weighted with the weights of the tokens at the mirrored distance.
diff --git a/crates/dluth-cuda/kernels/attention.cu b/crates/dluth-cuda/kernels/attention.cu
index e920501..f9bafe1 100644
--- a/crates/dluth-cuda/kernels/attention.cu
+++ b/crates/dluth-cuda/kernels/attention.cu
@@ -258,7 +258,7 @@ extern "C" __global__ void attn_values(const float* weights, const float* values
         const float* w = weights + run * stride;
         unsigned long long column = (size_t)(h / (heads / kv_heads)) * dim + e;
         for (unsigned long long d = seg; d < seen; d += segs)
