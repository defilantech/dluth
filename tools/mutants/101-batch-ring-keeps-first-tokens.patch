diff --git a/crates/dluth-cuda/kernels/attention.cu b/crates/dluth-cuda/kernels/attention.cu
index ac774e9..41543ac 100644
--- a/crates/dluth-cuda/kernels/attention.cu
+++ b/crates/dluth-cuda/kernels/attention.cu
@@ -143,7 +143,7 @@ extern "C" __global__ void ring_store(const float* current, float* ring, unsigne
     unsigned int b = (unsigned int)(index / channels);
     unsigned int c = (unsigned int)(index % channels);
     if (b >= batch || slots == 0) return;
