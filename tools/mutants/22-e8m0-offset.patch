# test: cargo test -p dluth-core e8m0_scale_is_a_power_of_two
# Bug: the power-of-two block scale is off by one exponent.
diff --git a/crates/dluth-core/src/dtype.rs b/crates/dluth-core/src/dtype.rs
index 3f0fd8e..9495f4a 100644
--- a/crates/dluth-core/src/dtype.rs
+++ b/crates/dluth-core/src/dtype.rs
@@ -102,7 +102,7 @@ pub fn e8m0_to_f32(code: u8) -> f32 {
         0 => f32::from_bits(1 << 22),
         255 => f32::INFINITY,
         // An f32 stores its exponent with the same offset of 127.
-        _ => f32::from_bits((code as u32) << 23),
+        _ => f32::from_bits((code as u32 + 1) << 23),
     }
 }
 
